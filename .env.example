# Copy this file to .env and replace this value with a long random secret.
APP_API_KEY=replace-with-a-random-32-character-secret
DATABASE_URL=sqlite:///./data/afriflow.db
# Optional hosted inference (requires internet and provider account)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ENABLE_LLM_PLANNER=false
POLL_SECONDS=60

# auto = Groq only if GROQ_API_KEY is present; off = never call any LLM.
# local = use the company-owned OpenAI-compatible server (Ollama / vLLM).
LLM_PROVIDER=auto
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen2.5:3b
LOCAL_LLM_API_KEY=
